<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The companion app talks only to a Family Agent master node it found on
         the LAN (mDNS discovery) or that the user typed in by hand, then
         authenticates with a username/password. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS/DNS-SD discovery of the master node needs multicast on Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Camera capture (Documents "Scan", Chat "Take photo") goes through
         ACTION_IMAGE_CAPTURE / the system camera app via ActivityResult's
         TakePicture — we never run the camera ourselves. Deliberately do NOT
         declare android.permission.CAMERA: with it declared, ACTION_IMAGE_CAPTURE
         requires a runtime grant; without it, the external camera app handles
         its own permissions and capture just works. uses-feature stays so
         Play doesn't hard-filter camera-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FamilyAgent"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FamilyAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Camera capture writes to a file under our own cache dir; the
             camera app needs a content:// URI (not a raw file:// path) to
             write into, which is what FileProvider is for. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- One size: a wide "launcher bar" (Claude/Gemini-app style), not a
     resizable free-for-all — the row of four tap targets (logo / field /
     mic / camera) doesn't have a sane way to reflow narrower than this. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="340dp"
    android:minHeight="90dp"
    android:minResizeWidth="320dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="5"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:initialLayout="@layout/glance_default_loading_layout" />

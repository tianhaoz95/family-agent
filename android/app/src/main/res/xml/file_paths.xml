<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Camera captures land in cache/scans/ (Documents) or cache/chat/
         (Chat), get uploaded, then are the app's own temp files to clean up
         — never the shared gallery. -->
    <cache-path name="scans" path="scans/" />
    <cache-path name="chat" path="chat/" />
    <!-- A gallery photo decoded back to a real file just long enough to hand
         off to a share-sheet Intent — see GalleryScreen.kt. -->
    <cache-path name="gallery" path="gallery/" />
</paths>

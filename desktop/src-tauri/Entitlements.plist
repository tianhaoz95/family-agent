<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone (Chat voice input, via the WKWebView). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The app spawns a bundled `node` running agent-core; the hardened runtime
       needs these to allow executing a non-notarized helper + JIT. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Deliberately NOT app-sandboxed: the sidecar spawn, `lsof`, and localhost
       networking all need an unsandboxed process. -->
</dict>
</plist>

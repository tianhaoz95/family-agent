<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Family Agent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Launch screen: the app's own warm paper canvas, so there's no white or
	     black flash before the first frame. The empty UIColorName that used to be
	     here named a colour asset that doesn't exist. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Discovery of the home server on the LAN (NWBrowser + active probe). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Family Agent looks for your home server on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_familyagent._tcp</string>
	</array>
	<!-- The home server is reached over plain http on the LAN / localhost. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>NSMicrophoneUsageDescription</key>
	<string>Family Agent records a short voice clip and sends it to your home server to transcribe.</string>
	<key>NSCameraUsageDescription</key>
	<string>Family Agent uses the camera to scan documents and attach photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Family Agent attaches photos you pick to a chat message or a document.</string>

	<!-- Bundled variable fonts (Resources/Fonts, auto-copied by the synchronized group). -->
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Variable.ttf</string>
		<string>SourceSerif4-Regular.ttf</string>
	</array>
</dict>
</plist>
